{
    "id": "Run-Tracker",
    "name": "Run Tracker",
    "short_name": "Run Tracker",
    "description": "Track your outdoor runs with GPS. Record distance, time, pace and speed, keep every run on your phone, and optionally upload a run to view its route on a map.",
    "lang": "en-US",
    "theme_color": "#bf360c",
    "orientation": "natural",
    "start_url": "/index.html",
    "icons": [
        {
            "src": "/assets/icons/kaios_56.png",
            "type": "image/png",
            "sizes": "56x56"
        },
        {
            "src": "/assets/icons/kaios_112.png",
            "type": "image/png",
            "sizes": "112x112"
        }
    ],
    "b2g_features": {
        "subtitle": "GPS running tracker",
        "type": "web",
        "permissions": {
            "geolocation": ""
        },
        "version": "1.0.0",
        "developer": {
            "name": "elliscode",
            "url": "http://www.elliscode.com"
        }
    }
}
